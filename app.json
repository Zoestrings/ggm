{
  "expo": {
    "name": "ggm",
    "slug": "ggm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zoestrings.ggm",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow GGM to use your location to verify attendance at church activities."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GGM to use your camera to capture verification selfies."
        }
      ],
      "expo-sharing"
    ]
  }
}
